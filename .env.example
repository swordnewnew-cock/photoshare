# 复制这个文件为 .env 再填写(cp .env.example .env)
# .env 已在 .gitignore 中,不会被提交

# ---------- 腾讯云 COS(图片存储) ----------
# 全部留空时,图片会自动存到本地 static/uploads,方便开发调试
# 建桶:https://console.cloud.tencent.com/cos,权限选"公有读私有写"
# 密钥建议在 CAM 建子账号并只授权这个桶,不要用主账号密钥
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
# 桶名完整格式,形如 photoshare-1251234567
COS_BUCKET=
# 自定义 CDN 域名(可选),留空则用 COS 默认域名
COS_DOMAIN=

# ---------- 安全 ----------
# 上线前务必改成随机字符串:
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-random-string

# ---------- 数据库 ----------
DB_PATH=./data/app.db
